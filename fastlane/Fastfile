# Fastlane — Kinnav (com.americangroupllc.kinnav)
#
# Ported from CalcMaster with its hard-won fixes already applied:
#   - flutter_sh: strip the bundler env before invoking Flutter
#   - __dir__-anchored paths for Ruby actions (they run with CWD = repo root)
#   - submit_for_review: false; submission is driven by tools/ios_submit_for_review.rb
#   - add_id_info_uses_idfa reflects what the build actually does

require "base64"
require "shellwords"
require "tmpdir"

default_platform(:ios)

APP_ID = "com.americangroupllc.kinnav".freeze
APP_NAME = "Kinnav".freeze
AAB_PATH = File.expand_path("../build/app/outputs/bundle/release/app-release.aab", __dir__).freeze

ASC_KEY_ID = ENV.fetch("ASC_KEY_ID", "UV8NYF9767").freeze

# Where the .p8 lives, in preference order. Resolving it here means the lanes
# run with no environment at all — `bundle exec fastlane ios upload` is the
# whole command.
#
# This used to demand a pre-exported ASC_KEY_CONTENT holding the base64 of the
# key. That is easy to get wrong: a shell that wraps the line breaks the
# `$(base64 …)` substitution and the variable silently ends up empty, so the
# lane aborts having done nothing. Reading the file directly removes the step.
def asc_key_path
  [
    ENV["ASC_KEY_PATH"],
    File.expand_path("../AuthKey_#{ASC_KEY_ID}.p8", __dir__),
    File.expand_path("~/Downloads/AuthKey_#{ASC_KEY_ID}.p8"),
    File.expand_path("~/agl/CalcMaster/AuthKey_#{ASC_KEY_ID}.p8")
  ].compact.find { |p| File.exist?(p) }
end

def asc_api_key
  key_content = ENV["ASC_KEY_CONTENT"].to_s.strip

  if key_content.empty?
    path = asc_key_path
    if path.nil?
      UI.user_error!("No AuthKey_#{ASC_KEY_ID}.p8 found. Put it in the repo root, " \
        "or set ASC_KEY_PATH=/path/to/AuthKey_#{ASC_KEY_ID}.p8, " \
        "or export ASC_KEY_CONTENT with its base64.")
    end
    UI.message("Using App Store Connect key #{path}")
    key_content = Base64.strict_encode64(File.read(path))
  end

  app_store_connect_api_key(
    key_id: ASC_KEY_ID,
    issuer_id: ENV.fetch("ASC_ISSUER_ID", "ec93cc91-97c2-4b03-860b-697d7ec5d1fb"),
    key_content: key_content,
    is_key_content_base64: true,
    in_house: false
  )
end

def latest_ipa
  ipa = Dir[File.expand_path("../build/ios/ipa/*.ipa", __dir__)].max_by { |f| File.mtime(f) }
  UI.user_error!("No .ipa in build/ios/ipa — run the ios `build` lane first") if ipa.nil?
  ipa
end

def play_json_key
  ENV.fetch("PLAY_JSON_KEY_FILE", "fastlane/play-service-account.json")
end

# The Android lanes used to call a bare `flutter build appbundle --release`.
# Every one of these values is a --dart-define with a *safe local default* in
# lib/config/app_config.dart — BACKEND falls back to "mock" and FLAVOR to "dev"
# — so the bare build compiled fine, signed fine, uploaded fine, and put a
# mock-backend build in front of real testers. Nothing failed; it just shipped
# the wrong app. scripts/build_release.sh and .github/workflows/release.yml
# both passed these already; only fastlane did not.
def release_defines
  defines = [
    "--dart-define=BACKEND=americangroupllc",
    "--dart-define=FLAVOR=prod"
  ]

  maps = ENV["MAPS_API_KEY"].to_s.strip
  if maps.empty?
    # LiveMap silently degrades to the non-Google MapView placeholder without
    # this. On an app whose main screen is a guardian map, that is not a
    # release. Set ALLOW_NO_MAPS_KEY=1 to build one deliberately.
    unless ENV["ALLOW_NO_MAPS_KEY"] == "1"
      UI.user_error!("MAPS_API_KEY is not set — the build would ship with no " \
        "Google Maps key and LiveMap would fall back to the placeholder map. " \
        "Export MAPS_API_KEY=… , or set ALLOW_NO_MAPS_KEY=1 to override.")
    end
    UI.important("Building with no MAPS_API_KEY (ALLOW_NO_MAPS_KEY=1)")
  else
    defines << "--dart-define=MAPS_API_KEY=#{maps.shellescape}"
  end

  agora = ENV["AGORA_APP_ID"].to_s.strip
  defines << "--dart-define=AGORA_APP_ID=#{agora.shellescape}" unless agora.empty?

  defines.join(" ")
end

PROFILE_DIRS = [
  "~/Library/MobileDevice/Provisioning Profiles",
  "~/Library/Developer/Xcode/UserData/Provisioning Profiles"
].map { |d| File.expand_path(d) }.freeze

def profile_field(path, key)
  plist = `security cms -D -i #{path.shellescape} 2>/dev/null`
  return nil if plist.empty?

  Dir.mktmpdir do |tmp|
    f = File.join(tmp, "p.plist")
    File.write(f, plist)
    value = `/usr/libexec/PlistBuddy -c 'Print :#{key}' #{f.shellescape} 2>/dev/null`.strip
    value.empty? ? nil : value
  end
end

# `xcodebuild -exportArchive` resolves a provisioning profile by NAME. A profile
# left over from an earlier run has the same name, so if it is missing a
# capability the entitlements declare, it shadows the fresh, correct one — and
# the export fails with a message that blames the portal rather than the stale
# file on disk. That cost a full debug cycle here. Delete every installed copy
# that is not the profile we just fetched.
def prune_stale_profiles!(keep_path)
  name = profile_field(keep_path, "Name")
  keep = profile_field(keep_path, "UUID")
  return if name.nil? || keep.nil?

  PROFILE_DIRS.each do |dir|
    Dir[File.join(dir, "*.mobileprovision")].each do |f|
      next unless profile_field(f, "Name") == name
      next if profile_field(f, "UUID") == keep

      File.delete(f)
      UI.important("Removed stale profile #{File.basename(f)} (same name as #{name})")
    end
  end
end

# fastlane runs under `bundle exec`, and a plain `sh` passes that environment
# (BUNDLE_GEMFILE, RUBYOPT=-rbundler/setup) to the child. Flutter then shells
# out to `pod`, bundler/setup rejects it because cocoapods is not in the
# Gemfile, and Flutter aborts with "CocoaPods is installed but broken".
def flutter_sh(cmd)
  runner = lambda { sh("cd .. && flutter #{cmd}") }
  if defined?(Bundler) && Bundler.respond_to?(:with_unbundled_env)
    Bundler.with_unbundled_env(&runner)
  elsif defined?(Bundler) && Bundler.respond_to?(:with_clean_env)
    Bundler.with_clean_env(&runner)
  else
    runner.call
  end
end

platform :ios do
  desc "Run the Flutter test suite"
  lane :test do
    flutter_sh("test")
  end

  desc "Build a signed App Store IPA (manual signing)"
  lane :build do
    setup_ci if ENV["CI"]

    get_provisioning_profile(
      api_key: asc_api_key,
      app_identifier: APP_ID,
      force: true
    )

    # `xcodebuild -exportArchive` resolves profiles by name from Xcode's own
    # profile stores, not from the .mobileprovision sigh drops in the repo.
    # Without this the archive builds and the *export* fails with
    # "Provisioning profile ... doesn't include the Sign In with Apple
    # capability" even when the profile on the portal is correct.
    install_provisioning_profile(path: lane_context[SharedValues::SIGH_PROFILE_PATH])
    prune_stale_profiles!(lane_context[SharedValues::SIGH_PROFILE_PATH])

    # Anchored to __dir__: Ruby actions run with CWD = repo root, so a literal
    # "../ios/..." would escape the repository.
    update_code_signing_settings(
      use_automatic_signing: false,
      path: File.expand_path("../ios/Runner.xcodeproj", __dir__),
      team_id: ENV.fetch("APPLE_TEAM_ID", "TLH7Z3G27A"),
      bundle_identifier: APP_ID,
      code_sign_identity: "Apple Distribution",
      profile_name: lane_context[SharedValues::SIGH_NAME],
      targets: ["Runner"]
    )

    build_number = ENV["BUILD_NUMBER"].to_s.strip
    flags = "--release --export-method app-store"
    flags += " --build-number=#{build_number}" unless build_number.empty?
    flutter_sh("build ipa #{flags}")

    # `flutter build ipa` exits 0 even when the IPA export step fails — it
    # prints "Encountered error while creating the IPA" and still returns
    # success, so fastlane reports a green build with no artifact. Fail loudly
    # instead of handing a missing file to the upload lane.
    if Dir[File.expand_path("../build/ios/ipa/*.ipa", __dir__)].empty?
      UI.user_error!("flutter build ipa reported success but produced no .ipa — " \
        "check the export step in the log above (usually a provisioning profile " \
        "that is missing a capability the entitlements file declares).")
    end
  end

  desc "Build + upload to TestFlight"
  lane :beta do
    build
    upload
  end

  desc "Upload the existing .ipa to TestFlight (no rebuild)"
  lane :upload do
    # Separate from `beta` so a verified binary can be shipped without being
    # rebuilt — a rebuild produces a different binary than the one that was
    # checked, and on a safety app that difference is worth avoiding.
    upload_to_testflight(
      api_key: asc_api_key,
      ipa: latest_ipa,
      app_identifier: APP_ID,
      skip_waiting_for_build_processing: true,
      # Nothing here is shown to external testers yet; internal testers on the
      # team get the build immediately without a review step.
      distribute_external: false,
      notify_external_testers: false
    )
  end

  desc "Push listing metadata only — no binary, no screenshots"
  lane :metadata do
    # Metadata travels over the App Store Connect REST API, not the Java
    # transporter that altool uses, so this works on machines where the binary
    # upload is blocked. Lets the listing be filled in while the build is still
    # being delivered by other means.
    upload_to_app_store(
      api_key: asc_api_key,
      app_identifier: APP_ID,
      skip_binary_upload: true,
      skip_screenshots: true,
      skip_app_version_update: false,
      force: true,                        # no interactive HTML preview
      precheck_include_in_app_purchases: false,
      submit_for_review: false,
      run_precheck_before_submit: false
    )
  end

  desc "Push screenshots only — no binary, no metadata"
  lane :screenshots do
    # Screenshots go over the REST API too, so they upload fine on machines
    # where the Java binary transport is blocked.
    #
    # Capture them with `--dart-define=SCREENSHOT=true`: iOS release builds
    # cannot run on a simulator, so shots come from a debug build, and that flag
    # hides the "Demo mode (dev)" buttons which do not exist in the shipped app.
    # A screenshot showing UI the release binary lacks is a rejection.
    upload_to_app_store(
      api_key: asc_api_key,
      app_identifier: APP_ID,
      skip_binary_upload: true,
      skip_metadata: true,
      skip_screenshots: false,
      overwrite_screenshots: true,
      screenshots_path: File.expand_path("screenshots", __dir__),
      force: true,
      run_precheck_before_submit: false,
      submit_for_review: false
    )
  end

  desc "Build + upload binary, metadata and screenshots (does NOT submit)"
  lane :release do
    build
    upload_to_app_store(
      api_key: asc_api_key,
      app_identifier: APP_ID,
      ipa: latest_ipa,
      # deliver's submit_for_review submits the VERSION alone. On a first
      # release Apple reviews in-app purchases alongside it, so submission is
      # driven separately by tools/ios_submit_for_review.rb.
      submit_for_review: false,
      automatic_release: true,
      force: true,
      precheck_include_in_app_purchases: false,
      submission_information: {
        add_id_info_uses_idfa: false,
        export_compliance_uses_encryption: false
      }
    )
  end
end

platform :android do
  desc "Build + upload the AAB to the Play internal track"
  lane :beta do
    flutter_sh("build appbundle --release #{release_defines}")
    upload_to_play_store(
      track: "internal",
      aab: AAB_PATH,
      json_key: play_json_key,
      skip_upload_apk: true,
      metadata_path: "fastlane/metadata/android"
    )
  end

  desc "Build + upload the AAB straight to production"
  lane :release do
    flutter_sh("build appbundle --release #{release_defines}")
    upload_to_play_store(
      track: "production",
      aab: AAB_PATH,
      json_key: play_json_key,
      skip_upload_apk: true,
      release_status: "completed",
      metadata_path: "fastlane/metadata/android"
    )
  end
end
