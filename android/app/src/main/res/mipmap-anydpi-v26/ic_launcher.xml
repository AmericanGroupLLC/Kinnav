<?xml version="1.0" encoding="utf-8"?>
<!-- Without this, Android masks the legacy square icon by shrinking it into
     the launcher shape on a white plate. The adaptive icon fills the shape
     with the brand gradient and keeps the mark inside the 66dp safe zone. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
