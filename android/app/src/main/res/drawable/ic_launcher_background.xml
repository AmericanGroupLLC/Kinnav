<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive-icon background: the brand gradient, matching the iOS icon and
     AppColors. Deeper than AppColors.primaryGradient because the mark is
     itself light lavender and would blend into the lighter ramp. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:type="linear"
        android:angle="315"
        android:startColor="#9B59D0"
        android:endColor="#6A1B9A" />
</shape>
