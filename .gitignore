# Flutter / Dart
.dart_tool/
.packages
build/
.flutter-plugins
.flutter-plugins-dependencies
.metadata

# pubspec.lock IS tracked. It was ignored here, which is the right default for a
# published Dart *package* and the wrong one for an app: without it CI resolves
# its own transitive versions, so the reviewed build and the shipped build can
# differ. Kinnav is an app.

# IDE
.idea/
*.iml
.vscode/

# macOS
.DS_Store

# iOS
ios/Pods/
ios/.symlinks/
ios/Flutter/Flutter.framework
ios/Flutter/Flutter.podspec
ios/Flutter/flutter_export_environment.sh
ios/Flutter/Generated.xcconfig

# Android
android/.gradle/
android/local.properties
android/key.properties

# Source design material now lives under requirements/ and IS tracked.
# Stray originals in the repo root (if any) stay out:
/WhatsApp Image*.jpeg
/*.pptx


# Local Flutter SDK copy (workdir-writable, ~3.9GB)
.flutter-sdk/
_sim_*.png

# Test artefacts
coverage/
website/test-results/
website/playwright-report/
*.p8
*.p12
*.mobileprovision

# Play Console service-account key — grants upload rights, never commit it.
fastlane/play-service-account.json
*.jks
*.keystore

# Local build secrets (MAPS_API_KEY, AGORA_APP_ID) sourced by the release lanes.
.env.release

# Downloaded release artifacts. `gh release download` drops these in the repo
# root; they are tens of megabytes and rebuilt every release, so they belong on
# a GitHub release, never in git. See store/README.md.
/app-release.aab
/app-release.apk
/bundle/
/flutter-apk/
*.ipa

# fastlane rewrites this JUnit report on every lane run, so it showed up as a
# diff after each release and once carried a local stack trace into a commit.
fastlane/report.xml

# The store screenshots ARE release assets and must be tracked. A global
# ~/.gitignore_global rule (fastlane/screenshots/**/*.png) was silently keeping
# the whole iOS set out of the repo, so it existed only on one Mac and on App
# Store Connect. A repo .gitignore beats the global excludes file, so this
# negation is what puts them back under version control.
!fastlane/screenshots/**/*.png
