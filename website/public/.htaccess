# Kinnav — Apache/cPanel config (HostGator)
# Upload the contents of dist/ into /home2/safecode/kinnav.com/
# This file must sit next to index.html in that folder.

DirectoryIndex index.html
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Never touch AutoSSL / Let's Encrypt validation requests
  RewriteRule ^\.well-known/ - [L]

  # Force HTTPS. AutoSSL validation still works (see .well-known rule above),
  # but until a certificate is actually issued for kinnav.com the browser will
  # show a warning — comment out the next two lines if you need plain HTTP
  # while waiting on AutoSSL.
  RewriteCond %{HTTPS} !=on
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

  # Canonical host: www.kinnav.com -> kinnav.com
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

  # SPA routing: serve index.html for any path that is not a real file/dir
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>

# ---- MIME types --------------------------------------------------------
<IfModule mod_mime.c>
  AddType image/svg+xml            .svg
  AddType application/manifest+json .webmanifest
  AddType font/woff2               .woff2
  AddType text/javascript          .js .mjs
</IfModule>

# ---- Compression -------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml \
    text/javascript application/javascript application/json \
    application/xml image/svg+xml application/manifest+json
</IfModule>

# ---- Caching -----------------------------------------------------------
# Vite emits content-hashed filenames under /assets, so those are immutable.
# index.html must never be cached or users get stale bundles after a deploy.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault                          "access plus 1 month"
  ExpiresByType text/html                 "access plus 0 seconds"
  ExpiresByType image/jpeg                "access plus 1 month"
  ExpiresByType image/png                 "access plus 1 month"
  ExpiresByType image/svg+xml             "access plus 1 month"
  ExpiresByType text/css                  "access plus 1 year"
  ExpiresByType text/javascript           "access plus 1 year"
  ExpiresByType application/javascript    "access plus 1 year"
  ExpiresByType font/woff2                "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  # Hashed bundle output only — images keep the 1-month default above so a
  # replaced /images/*.jpg is picked up without a filename change.
  <FilesMatch "\.(js|mjs|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Basic hardening
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ---- Error document ----------------------------------------------------
# The SPA rewrite above means React Router renders the 404 page; this only
# fires if index.html itself is missing.
ErrorDocument 404 /index.html
